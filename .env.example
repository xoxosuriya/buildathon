# ==============================================================================
# IntentLock Environment Variables Template (.env.example)
# Copy this file to .env locally and fill in your actual credentials.
# NEVER commit real credentials to GitHub.
# ==============================================================================

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# OpenAI API Key (Required for LLM AI Autonomous Agent Purchasing)
OPENAI_API_KEY=

# Razorpay Merchant Credentials (Required for Payment Gateway Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Database Configuration (Defaults to local SQLite if unset)
DATABASE_URL=sqlite:///./intentlock.db

# 21st.dev MCP Server API Key (Optional for component catalog integration)
API_KEY_21ST=
