# ==============================================================================
# IntentLock Backend Environment Variables Template (.env.example)
# Copy this file to backend/.env locally and fill in your actual credentials.
# ==============================================================================

# OpenAI API Key (Required for LLM AI Autonomous Agent Purchasing)
OPENAI_API_KEY=

# Razorpay Test Credentials (Required for Payment Gateway Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Database Configuration
DATABASE_URL=sqlite:///./intentlock.db
